<?xml version="1.0" encoding="utf-8"?>
<!--
  Primeiro plano do ícone: um halter de traço único (cabo + dois discos de cada lado), em verde-limão (#C6F432,
  o acento do Carbon). Fica dentro da zona segura de 66 dp no centro de 108 dp, então nenhuma máscara
  (círculo, squircle, gota) corta o desenho. Sem emoji, sem robô: DESIGN.md §4.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- cabo -->
    <path
        android:pathData="M40,54 L68,54"
        android:strokeColor="#C6F432"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- discos internos (altos) -->
    <path
        android:pathData="M40,39 L40,69 M68,39 L68,69"
        android:strokeColor="#C6F432"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <!-- discos externos (baixos) -->
    <path
        android:pathData="M31,46 L31,62 M77,46 L77,62"
        android:strokeColor="#C6F432"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
</vector>
